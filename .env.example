# Copy to .env.local and fill in. Never commit real values.

# Public site URL — canonical links, sitemap, Open Graph, structured data.
NEXT_PUBLIC_SITE_URL=https://afterbyte.example

# --- Contact form delivery (server-only; never prefix with NEXT_PUBLIC_) ---
# Where inquiries are sent, and the sender address (must be allowed by your provider).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option A — SMTP (works with most mail hosts, e.g. Google Workspace, Zoho, Fastmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for implicit TLS (usually port 465). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=

# Option B — Resend (HTTPS API). If set, takes precedence over SMTP.
RESEND_API_KEY=
